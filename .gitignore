
# Virtualenvs are platform-specific: copying one between machines
# replaces a working interpreter with a foreign binary.
.venv/

# Training runs.  V1.0 tracks only the runs that back a documented result;
# everything else is diagnosis and is regenerated by the scripts in scripts/.
# New runs are ignored by default -- force-add one deliberately with
#   git add -f outputs/<run>
# when it becomes a result worth keeping.
outputs/*/
!outputs/_evidence/
!outputs/big_w10_v2_s*/
!outputs/big_w5_v2_s*/
!outputs/big_w10_v3_s*/
!outputs/big_w5_v3_s*/
!outputs/n3v2_s0/
!outputs/n3v2_epibe/
!outputs/n3v2_epibe_cell2/
!outputs/n3v2_biased_pibe/
!outputs/n3v2_corrected_pibe/
!outputs/n3v2_unbiased_pibe/
!outputs/n3v2_contam_epibe/
!outputs/n3v2_contam_pibe/
!outputs/n3v2_gauss_pibe/
!outputs/n3v2_K100_epibe/
!outputs/n3v2_K100_pibe/
!outputs/n3v2_K100_gauss/
!outputs/bb_epibe_b0.5_BE12.0/
!outputs/bb_pibe_b0.5_BE12.0/
!outputs/gen_p256/
outputs/*.log
